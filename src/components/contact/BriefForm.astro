---
/**
 * "Send a brief": classic form. Works without JS (POST + 303 redirect to
 * /contact/sent); with JS it submits in place and shows the next steps.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import { choiceLabel } from '@/lib/contact/schema';
import FormMeta from './FormMeta.astro';
import { briefInput, briefLabel, buttonPrimary, card, errorText, eyebrow, stepTitle } from './ui';

interface Props {
  config: CollectionEntry<'contact'>['data']['brief'];
}

const { config } = Astro.props;
const half = 'col-span-2 sm:col-span-1';
---

<div class:list={['contact-flow', card]} data-contact-flow="brief">
  <form method="post" action="/api/contact" class="grid grid-cols-2 gap-5" data-contact-form>
    <FormMeta flow="brief" />
    <div class={half}>
      <label for="brief-name" class={briefLabel}>
        Tu nombre
      </label>
      <input
        id="brief-name"
        type="text"
        name="name"
        required
        maxlength="100"
        autocomplete="name"
        placeholder="Juana Pérez"
        class={briefInput}
      />
    </div>
    <div class={half}>
      <label for="brief-email" class={briefLabel}>
        Email
      </label>
      <input
        id="brief-email"
        type="email"
        name="email"
        required
        maxlength="254"
        autocomplete="email"
        placeholder="vos@estudio.com"
        class={briefInput}
      />
    </div>
    <div class={half}>
      <label for="brief-company" class={briefLabel}>
        Empresa
      </label>
      <input
        id="brief-company"
        type="text"
        name="company"
        maxlength="120"
        autocomplete="organization"
        placeholder="Acme Inc."
        class={briefInput}
      />
    </div>
    <div class={half}>
      <label for="brief-budget" class={briefLabel}>
        Presupuesto
      </label>
      <select id="brief-budget" name="budget" class={briefInput}>
        <option value="" selected>
          Elegí…
        </option>
        {config.budgets.map((b) => (
          <option value={b}>{choiceLabel(b)}</option>
        ))}
      </select>
    </div>
    <fieldset class="col-span-2 min-w-0">
      <legend class={briefLabel}>¿Qué necesitás?</legend>
      <div class="flex flex-wrap gap-2">
        {config.services.map((service) => (
          <label class="relative cursor-pointer">
            <input type="checkbox" name="services" value={service} class="peer sr-only" />
            <span class="inline-block rounded-full border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors peer-checked:border-foreground peer-checked:bg-foreground peer-checked:text-background peer-focus-visible:ring-2 peer-focus-visible:ring-foreground peer-focus-visible:ring-offset-2 hover:text-foreground peer-checked:hover:text-background">
              {choiceLabel(service)}
            </span>
          </label>
        ))}
      </div>
    </fieldset>
    <div class="col-span-2">
      <label for="brief-message" class={briefLabel}>
        Brief del proyecto
      </label>
      <textarea
        id="brief-message"
        name="message"
        required
        rows="6"
        maxlength="5000"
        placeholder="Contanos sobre el trabajo, los plazos y qué sería un éxito para vos."
        class={briefInput}
      ></textarea>
    </div>
    <div class="col-span-2 flex flex-wrap items-center justify-between gap-4 pt-2">
      <p class="text-xs text-muted-foreground">
        Al enviar aceptás nuestros{' '}
        <a href="/terms" class="underline-offset-2 hover:underline">
          términos
        </a>
        .
      </p>
      <button
        type="submit"
        class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-transform hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 disabled:opacity-60 disabled:hover:translate-y-0"
        data-submit
      >
        <span data-submit-label data-idle={config.submitLabel}>
          {config.submitLabel}
        </span>
        <Icon name="arrow-up-right" class="h-4 w-4" />
      </button>
    </div>
    <p class:list={[errorText, 'col-span-2 mt-0']} role="alert" data-error hidden></p>
  </form>

  <template id="brief-success">
    <div role="status" tabindex="-1" class="focus:outline-none">
      <span class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-foreground px-3 py-1 text-xs text-background">
          <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>Brief
          recibido
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
          Ticket <span class="font-mono text-foreground" data-slot="ticket"></span>
        </span>
      </span>
      <h3 class:list={[stepTitle, 'mt-4']} data-slot="title"></h3>
      <ol class="mt-5 space-y-3">
        {config.success.steps.map((step, i) => (
          <li class="flex items-center gap-3 text-sm leading-relaxed text-muted-foreground">
            <span class="grid size-6 shrink-0 place-items-center rounded-full border border-border text-[11px] font-medium text-foreground">
              {i + 1}
            </span>
            {step}
          </li>
        ))}
      </ol>
      <p class="mt-5 text-sm text-muted-foreground">
        Te respondemos dentro de{' '}
        <span class="font-medium text-foreground">{config.success.replyWithin}</span>.
      </p>
      <a href={config.success.bookingUrl} class:list={[buttonPrimary, 'mt-5']} rel="noopener">
        <span class="inline-flex shrink-0 items-center justify-center px-1">
          Agendá una llamada ahora
        </span>
      </a>
      <div role="separator" class="my-6 h-px w-full bg-border"></div>
      <p class={eyebrow}>Mientras esperás</p>
      <ul class="mt-3 space-y-1.5">
        {config.success.caseStudies.map((study) => (
          <li>
            <a
              href={study.href}
              class="inline-flex items-center gap-1 rounded-sm text-sm font-medium whitespace-nowrap text-muted-foreground underline-offset-3 transition-colors hover:underline active:text-foreground"
            >
              <span>{study.title}</span>
              <Icon name="arrow-up-right" class="size-[18px] shrink-0" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </template>
</div>
