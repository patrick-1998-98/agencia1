---
/**
 * <template> for the generic "Sent" state (project + specialist flows).
 * The client clones it and fills the [data-slot] nodes with textContent.
 */
import Icon from '@/components/ui/Icon.astro';
import { buttonPrimary } from './ui';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<template id={id}>
  <div class="flex flex-col items-start gap-3 py-12 md:py-14" role="status" tabindex="-1">
    <span class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-foreground px-3 py-1 text-xs text-background">
        <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>Sent
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
        Ticket <span class="font-mono text-foreground" data-slot="ticket"></span>
      </span>
    </span>
    <h3 class="text-2xl font-medium tracking-tight" data-slot="title"></h3>
    <p class="max-w-md text-sm text-muted-foreground" data-slot="description"></p>
    <a class:list={[buttonPrimary, 'mt-3']} data-slot="action" hidden>
      <span
        class="inline-flex shrink-0 items-center justify-center px-1"
        data-slot="action-label"
      ></span>
      <Icon name="arrow-up-right" class="size-5 shrink-0" />
    </a>
  </div>
</template>
