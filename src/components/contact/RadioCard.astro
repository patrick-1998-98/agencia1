---
/** Card-style radio (title + description + round indicator). */
interface Props {
  name: string;
  value: string;
  title: string;
  description: string;
  required?: boolean;
  data?: Record<string, string>;
}

const { name, value, title, description, required, data = {} } = Astro.props;
const dataAttrs = Object.fromEntries(Object.entries(data).map(([k, v]) => [`data-${k}`, v]));
---

<label class="group relative flex w-full cursor-pointer items-center justify-between gap-3 rounded-2xl border border-border bg-card py-3 ps-4 pe-5 transition-colors duration-150 select-none hover:bg-muted has-checked:border-foreground has-focus-visible:ring-2 has-focus-visible:ring-foreground">
  <input
    type="radio"
    class="sr-only"
    name={name}
    value={value}
    required={required}
    {...dataAttrs}
  />
  <span class="flex min-w-0 flex-col gap-0.5">
    <span class="truncate text-sm font-medium text-foreground">{title}</span>
    <span class="truncate text-sm text-muted-foreground">{description}</span>
  </span>
  <span class="flex shrink-0 items-center py-1">
    <span
      aria-hidden="true"
      class="relative flex size-4 shrink-0 items-center justify-center rounded-full"
    >
      <span class="absolute inset-0 rounded-full border border-border bg-card shadow-xs transition-opacity duration-200 group-has-checked:opacity-0"></span>
      <span class="absolute inset-0 rounded-full bg-foreground opacity-0 transition-opacity duration-200 group-has-checked:opacity-100"></span>
      <span class="absolute top-1/2 left-1/2 size-1.5 -translate-1/2 scale-0 rounded-full bg-card opacity-0 transition-[scale,opacity] duration-200 group-has-checked:scale-100 group-has-checked:opacity-100"></span>
    </span>
  </span>
</label>
