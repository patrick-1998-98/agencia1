---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import type { Section as SectionData } from '@/lib/sections';

interface Props {
  header: SectionData<'header'>;
}

const { header } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Section
  id="services"
  eyebrow={header.eyebrow}
  title={header.title}
  description={header.description}
>
  <div class="services-strip flex h-100 items-stretch gap-3 md:h-120">
    {services.map((service, index) => (
      <a
        href={`/services/${service.id}`}
        class="service-card group relative min-w-0 cursor-pointer overflow-hidden rounded-2xl bg-muted"
      >
        <div class="absolute inset-0">
          <Image
            src={service.data.image}
            alt=""
            widths={[400, 800]}
            sizes="(min-width: 1152px) 376px, 33vw"
            class="block h-full w-full object-cover"
          />
        </div>
        <span class="absolute top-4 left-4 z-10 text-xs font-semibold text-white/80 tabular-nums select-none [text-shadow:0_1px_2px_rgba(0,0,0,0.5)]">
          0{index + 1}
        </span>
        <span
          class="service-label pointer-events-none absolute inset-0 z-10 flex items-center justify-center px-2 py-10 text-base font-medium tracking-eyebrow text-white uppercase transition-opacity duration-300 [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]"
          aria-hidden="true"
        >
          <span class="service-label-text">{service.data.title}</span>
        </span>
        <div class="service-details absolute inset-x-0 bottom-0 z-10 p-5 transition-all duration-300">
          <h3 class="text-lg leading-tight font-medium text-white md:text-xl">
            {service.data.title}
          </h3>
          <p class="mt-1 text-sm leading-snug text-white/85">{service.data.summary}</p>
        </div>
      </a>
    ))}
  </div>
</Section>

<style>
  /* Hovered/focused card grows, the others shrink (accordion strip). */
  .service-card {
    flex: 1;
    transition: flex 500ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .services-strip:has(.service-card:is(:hover, :focus-visible)) .service-card {
    flex: 0.6;
  }
  .services-strip .service-card:is(:hover, :focus-visible) {
    flex: 3;
  }

  /* Vertical, bottom-to-top label; long names wrap onto a second column. */
  .service-label-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    max-height: 100%;
    text-align: center;
  }
  .service-card:is(:hover, :focus-visible) .service-label {
    opacity: 0;
  }

  .service-details {
    padding-top: 4rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.5) 60%, transparent);
    transform: translateY(12px);
    opacity: 0;
  }
  .service-card:is(:hover, :focus-visible) .service-details {
    transform: translateY(0);
    opacity: 1;
  }
</style>
