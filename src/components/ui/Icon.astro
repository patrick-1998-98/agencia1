---
/**
 * Inline SVG icon from src/icons/<name>.svg.
 * Icons are decorative by default (aria-hidden); pass `label` to expose one.
 */
interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className = 'h-4 w-4', label } = Astro.props;

const files = import.meta.glob<string>('/src/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const raw = files[`/src/icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" not found in src/icons`);

const viewBox = /viewBox="([^"]+)"/.exec(raw)?.[1] ?? '0 0 24 24';
const svgAttrs = /<svg([^>]*)>/.exec(raw)?.[1] ?? '';
const keep = (attr: string) => new RegExp(`${attr}="([^"]+)"`).exec(svgAttrs)?.[1];
const fill = keep('fill');
const stroke = keep('stroke');
const strokeWidth = keep('stroke-width');
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width="24"
  height="24"
  fill={fill}
  stroke={stroke}
  stroke-width={strokeWidth}
  stroke-linecap={stroke ? 'round' : undefined}
  stroke-linejoin={stroke ? 'round' : undefined}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
  set:html={inner}
/>
