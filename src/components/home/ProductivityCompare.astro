---
/**
 * "Productividad personal vs. empresarial": two diagrams side by side.
 * Left: people with their own AI tools, lines that lead nowhere, and one
 * person leaving with what they know. Right: the same people connected to a
 * company system, where a newcomer plugs into the slot the leaver left.
 *
 * Motion follows the rest of the site (see ProcessSteps): the columns use the
 * shared scroll reveal, and the diagrams play once via an `.is-active` class
 * with the same eases. The left sequence finishes before the right one starts.
 * Final positions are the default styles, so reduced motion and no-JS show
 * the end state.
 */
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Section as SectionData } from '@/lib/sections';

interface Props {
  content: SectionData<'productivity'>;
}

const { header, individual, company, closing } = Astro.props.content;

/* ---- Diagram geometry (viewBox 0 0 480 310) ---------------------------- */
const W = 480;
const H = 310;
const R = 28;
const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(2)}%`;

/** Individual: four people on their own; each line stops short with a "cut" tick. */
const loners = [
  { x: 104, y: 78 },
  { x: 370, y: 68 },
  { x: 84, y: 214 },
  { x: 176, y: 240 },
];
const stubs = [
  [136, 92, 180, 112],
  [338, 82, 296, 104],
  [116, 200, 160, 180],
  [198, 213, 222, 184],
].map(([x1, y1, x2, y2]) => {
  const len = Math.hypot(x2! - x1!, y2! - y1!);
  const [nx, ny] = [-(y2! - y1!) / len, (x2! - x1!) / len];
  return {
    line: `M${x1} ${y1} L${x2} ${y2}`,
    tick: `M${x2! + nx * 5} ${y2! + ny * 5} L${x2! - nx * 5} ${y2! - ny * 5}`,
  };
});
const leaver = { x: 314, y: 160 };
const leaveShift = 72;

/** Company: a core system with people wired to it, plus the slot a newcomer fills. */
const core = { x: 240, y: 152, size: 80 };
const members = [
  { x: 100, y: 80 },
  { x: 380, y: 80 },
  { x: 100, y: 224 },
];
const slot = { x: 380, y: 224 };
const wire = (to: { x: number; y: number }) => {
  const side = to.x < core.x ? -1 : 1;
  const sx = core.x + (side * core.size) / 2;
  const ex = to.x - side * R;
  return `M${sx} ${core.y} C${sx + side * 32} ${core.y} ${ex - side * 32} ${to.y} ${ex} ${to.y}`;
};

/* ---- Timeline (seconds after each diagram starts) ---------------------- */
const t = {
  individual: {
    people: (i: number) => i * 0.08,
    stub: (i: number) => 0.55 + i * 0.1,
    tick: (i: number) => 1.2 + i * 0.1,
    leave: 1.9,
    caption: 2.55,
  },
  company: {
    core: 0,
    people: (i: number) => 0.3 + i * 0.08,
    slot: 0.54,
    wire: (i: number) => 0.7 + i * 0.1,
    arrive: 1.6,
    plug: 2.2,
    caption: 2.75,
  },
};
const d = (seconds: number) => ({ '--d': `${seconds}s` });

/** Person glyph centred on (0, 0), drawn from the 24px icon grid. */
const personGlyph = {
  head: 'M0 -4.5 m-4.6 0 a4.6 4.6 0 1 0 9.2 0 a4.6 4.6 0 1 0 -9.2 0',
  body: 'M-8.6 10.5 c1.6 -4.1 4.9 -6.3 8.6 -6.3 s7 2.2 8.6 6.3',
};
const sparkle =
  'M0 -6 c.4 2.9 1.9 4.4 4.8 4.8 c-2.9 .4 -4.4 1.9 -4.8 4.8 c-.4 -2.9 -1.9 -4.4 -4.8 -4.8 c2.9 -.4 4.4 -1.9 4.8 -4.8 z';

const label = 'text-xs tracking-eyebrow uppercase';
const caption =
  'pc-pop pointer-events-none absolute w-max max-w-[36%] text-center text-[10px] leading-snug font-medium tracking-label uppercase sm:text-[11px]';
---

<Section
  id="productividad"
  eyebrow={header.eyebrow}
  title={header.title}
  description={header.description}
>
  <div class="border-t border-l border-dashed border-border" data-productivity>
    <div class="grid md:grid-cols-2" data-reveal-stagger="0.08" data-reveal-y="24">
      <!-- Individual -->
      <div class="flex flex-col border-r border-b border-dashed border-border bg-card p-6 md:p-8">
        <span class={`${label} text-muted-foreground`}>{individual.label}</span>
        <h3 class="mt-2 text-xl font-medium tracking-tight text-foreground md:text-2xl">
          {individual.title}
        </h3>
        <ul
          class="mt-5 flex flex-wrap gap-1.5"
          data-reveal-stagger="0.06"
          data-reveal-delay="0.25"
          data-reveal-y="8"
        >
          {individual.chips.map((chip) => (
            <li class="flex items-center gap-1.5 rounded-full border border-border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground">
              <svg viewBox="0 0 12 12" class="h-2.5 w-2.5 shrink-0" aria-hidden="true">
                <path
                  d="M3 3l6 6M9 3l-6 6"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
              {chip}
            </li>
          ))}
        </ul>

        <div
          class="relative mt-6 overflow-hidden rounded-2xl border border-border bg-background"
          data-stage="individual"
        >
          <svg
            viewBox={`0 0 ${W} ${H}`}
            class="block h-auto w-full"
            role="img"
            aria-label="Personas aisladas, cada una con su propia herramienta de IA; sus líneas no llegan a ningún lado y una de ellas se va de la empresa."
          >
            <defs>
              {stubs.map((stub, i) => (
                <mask id={`pc-stub-${i}`} maskUnits="userSpaceOnUse">
                  <path
                    d={stub.line}
                    class="pc-draw"
                    style={d(t.individual.stub(i))}
                    pathLength="1"
                    stroke="#fff"
                    stroke-width="8"
                    fill="none"
                  />
                </mask>
              ))}
            </defs>

            <!-- Lines that stop halfway -->
            <g
              class="stroke-muted-foreground/45"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
            >
              {stubs.map((stub, i) => (
                <>
                  <path d={stub.line} stroke-dasharray="3 5" mask={`url(#pc-stub-${i})`} />
                  <path d={stub.tick} class="pc-fade" style={d(t.individual.tick(i))} />
                </>
              ))}
            </g>

            <!-- The person leaving: dashed exit arrow behind, then slides out -->
            <g
              class="stroke-muted-foreground/40"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
            >
              <path
                d={`M${leaver.x + 38} ${leaver.y} H${leaver.x + leaveShift + 58}`}
                stroke-dasharray="3 5"
                mask="url(#pc-exit)"
              />
              <path
                d={`M${leaver.x + leaveShift + 52} ${leaver.y - 6} l7 6 l-7 6`}
                stroke-linejoin="round"
                class="pc-fade"
                style={d(t.individual.leave + 0.6)}
              />
            </g>
            <mask id="pc-exit" maskUnits="userSpaceOnUse">
              <path
                d={`M${leaver.x + 38} ${leaver.y} H${leaver.x + leaveShift + 58}`}
                class="pc-draw"
                style={d(t.individual.leave)}
                pathLength="1"
                stroke="#fff"
                stroke-width="8"
                fill="none"
              />
            </mask>

            <!-- People, each with their own AI tool -->
            {[...loners, leaver].map((p, i) => (
              <g transform={`translate(${p.x} ${p.y})`}>
                <g class="pc-pop" style={d(t.individual.people(i))}>
                  <g
                    class:list={[i === loners.length && 'pc-leave']}
                    style={i === loners.length ? d(t.individual.leave) : undefined}
                  >
                    <circle r={R} class="fill-card stroke-border" stroke-width="1" />
                    <g
                      class="stroke-muted-foreground"
                      stroke-width="1.6"
                      fill="none"
                      stroke-linecap="round"
                    >
                      <path d={personGlyph.head} />
                      <path d={personGlyph.body} />
                    </g>
                    <g transform="translate(21 -21)">
                      <circle r="10.5" class="fill-card stroke-border" stroke-width="1" />
                      <path d={sparkle} class="fill-muted-foreground" />
                    </g>
                  </g>
                </g>
              </g>
            ))}
          </svg>
          <p
            class={`${caption} text-muted-foreground`}
            style={{
              ...d(t.individual.caption),
              left: pct(leaver.x + leaveShift, W),
              top: pct(leaver.y + R + 12, H),
              transform: 'translateX(-50%)',
            }}
          >
            {individual.caption}
          </p>
        </div>
      </div>

      <!-- Company -->
      <div class="flex flex-col border-r border-b border-dashed border-border bg-foreground p-6 text-background md:p-8">
        <span class={`${label} text-background/60`}>{company.label}</span>
        <h3 class="mt-2 text-xl font-medium tracking-tight md:text-2xl">{company.title}</h3>
        <ul
          class="mt-5 flex flex-wrap gap-1.5"
          data-reveal-stagger="0.06"
          data-reveal-delay="0.25"
          data-reveal-y="8"
        >
          {company.chips.map((chip) => (
            <li class="flex items-center gap-1.5 rounded-full border border-background/15 bg-background/10 px-2.5 py-1 text-xs font-medium text-background/85">
              <Icon name="check" class="h-2.5 w-2.5 shrink-0" />
              {chip}
            </li>
          ))}
        </ul>

        <div
          class="relative mt-6 overflow-hidden rounded-2xl border border-background/10 bg-background/[0.04]"
          data-stage="company"
        >
          <svg
            viewBox={`0 0 ${W} ${H}`}
            class="block h-auto w-full"
            role="img"
            aria-label="Las mismas personas conectadas a un sistema central de la empresa; quien llega ocupa el lugar libre y se conecta al sistema."
          >
            <defs>
              <radialGradient id="pc-glow">
                <stop offset="0" stop-color="#4f46e5" stop-opacity="0.5" />
                <stop offset="1" stop-color="#4f46e5" stop-opacity="0" />
              </radialGradient>
            </defs>

            <circle
              cx={core.x}
              cy={core.y}
              r="128"
              fill="url(#pc-glow)"
              class="pc-fade pc-slow"
              style={d(t.company.core)}
            />

            <!-- Wires drawn from the core out to each person -->
            <g class="stroke-background/45" stroke-width="1.5" fill="none">
              {members.map((m, i) => (
                <path
                  d={wire(m)}
                  class="pc-draw"
                  style={d(t.company.wire(i))}
                  pathLength="1"
                  stroke-dasharray="1"
                />
              ))}
              <path
                d={wire(slot)}
                class="pc-draw"
                style={d(t.company.plug)}
                pathLength="1"
                stroke-dasharray="1"
              />
            </g>

            <!-- Core system -->
            <g transform={`translate(${core.x} ${core.y})`}>
              <g class="pc-core" style={d(t.company.core)}>
                <rect
                  x={-core.size / 2}
                  y={-core.size / 2}
                  width={core.size}
                  height={core.size}
                  rx="22"
                  class="fill-background"
                />
                <g class="stroke-foreground" stroke-width="1.8" fill="none" stroke-linecap="round">
                  <rect x="-15" y="-14" width="30" height="22" rx="4" />
                  <path d="M-8 3 V-1 M-2.5 3 V-7 M3 3 V-3 M8.5 3 V-9" />
                  <path d="M-7 15 H7" />
                </g>
              </g>
            </g>

            <!-- Team members -->
            {members.map((m, i) => (
              <g transform={`translate(${m.x} ${m.y})`}>
                <g class="pc-pop" style={d(t.company.people(i))}>
                  <circle r={R} class="fill-background/10 stroke-background/25" stroke-width="1" />
                  <g
                    class="stroke-background"
                    stroke-width="1.6"
                    fill="none"
                    stroke-linecap="round"
                  >
                    <path d={personGlyph.head} />
                    <path d={personGlyph.body} />
                  </g>
                </g>
              </g>
            ))}

            <!-- The free slot: dashed until the newcomer plugs in and closes the ring -->
            <g transform={`translate(${slot.x} ${slot.y})`}>
              <circle
                r={R}
                class="pc-pop stroke-background/50"
                style={d(t.company.slot)}
                fill="none"
                stroke-width="1.4"
                stroke-dasharray="4 4"
              />
              <g class="pc-arrive" style={d(t.company.arrive)}>
                <circle r={R} class="fill-background/10" />
                <g class="stroke-background" stroke-width="1.6" fill="none" stroke-linecap="round">
                  <path d={personGlyph.head} />
                  <path d={personGlyph.body} />
                </g>
              </g>
              <circle
                r={R}
                class="pc-draw stroke-background/60"
                style={d(t.company.plug + 0.35)}
                fill="none"
                stroke-width="1.4"
                pathLength="1"
                stroke-dasharray="1"
                transform="rotate(180)"
              />
            </g>
          </svg>
          <p
            class={`${caption} text-background/75`}
            style={{
              ...d(t.company.caption),
              left: pct(slot.x, W),
              top: pct(slot.y + R + 12, H),
              transform: 'translateX(-50%)',
            }}
          >
            {company.caption}
          </p>
        </div>
      </div>
    </div>
  </div>

  <p
    class="mx-auto mt-12 max-w-3xl text-center text-xl font-medium tracking-tight text-balance text-foreground md:text-2xl"
    data-reveal
    data-reveal-y="24"
  >
    {closing.lead} <span class="text-muted-foreground">{closing.rest}</span>
  </p>
</Section>

<style>
  /* Final state is the default; the pre-animation state only applies while
     JS runs, motion is allowed and the diagram has not started yet. */
  .pc-leave {
    translate: 72px 0;
    opacity: 0.32;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pc-pop {
      transition:
        opacity 0.6s cubic-bezier(0.215, 0.61, 0.355, 1) var(--d, 0s),
        translate 0.6s cubic-bezier(0.215, 0.61, 0.355, 1) var(--d, 0s);
    }
    .pc-core {
      transform-box: fill-box;
      transform-origin: center;
      transition:
        opacity 0.6s cubic-bezier(0.215, 0.61, 0.355, 1) var(--d, 0s),
        scale 0.6s cubic-bezier(0.215, 0.61, 0.355, 1) var(--d, 0s);
    }
    .pc-draw {
      transition: stroke-dashoffset 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--d, 0s);
    }
    .pc-fade {
      transition: opacity 0.4s ease-out var(--d, 0s);
    }
    .pc-slow {
      transition-duration: 0.9s;
    }
    .pc-leave {
      transition:
        translate 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--d, 0s),
        opacity 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--d, 0s);
    }
    .pc-arrive {
      transition:
        translate 0.9s cubic-bezier(0.215, 0.61, 0.355, 1) var(--d, 0s),
        opacity 0.6s ease-out var(--d, 0s);
    }

    :global(.js) [data-stage]:not(.is-active) .pc-pop {
      opacity: 0;
      translate: 0 10px;
    }
    :global(.js) [data-stage]:not(.is-active) .pc-core {
      opacity: 0;
      scale: 0.85;
    }
    :global(.js) [data-stage]:not(.is-active) .pc-draw {
      stroke-dashoffset: 1;
    }
    :global(.js) [data-stage]:not(.is-active) .pc-fade {
      opacity: 0;
    }
    :global(.js) [data-stage]:not(.is-active) .pc-leave {
      translate: 0 0;
      opacity: 1;
    }
    :global(.js) [data-stage]:not(.is-active) .pc-arrive {
      translate: 40px 0;
      opacity: 0;
    }
  }
</style>

<script>
  /** Start of each diagram after it scrolls in, and how long the left one runs. */
  const START_MS = 250;
  const INDIVIDUAL_MS = 3300;

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-productivity]').forEach((root) => {
    const individual = root.querySelector<HTMLElement>('[data-stage="individual"]');
    const company = root.querySelector<HTMLElement>('[data-stage="company"]');
    if (!individual || !company) return;
    if (reduce) {
      individual.classList.add('is-active');
      company.classList.add('is-active');
      return;
    }

    // The company diagram never starts before the individual one has finished,
    // so the two read as a before and an after (also when stacked on mobile).
    let individualDoneAt = 0;
    const startIndividual = () => {
      if (individualDoneAt) return;
      individualDoneAt = performance.now() + START_MS + INDIVIDUAL_MS;
      setTimeout(() => individual.classList.add('is-active'), START_MS);
    };
    const startCompany = () => {
      startIndividual();
      const wait = Math.max(START_MS, individualDoneAt - performance.now());
      setTimeout(() => company.classList.add('is-active'), wait);
    };

    const onceVisible = (el: HTMLElement, callback: () => void) => {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          observer.disconnect();
          callback();
        },
        { rootMargin: '0px 0px -18% 0px' },
      );
      observer.observe(el);
    };
    onceVisible(individual, startIndividual);
    onceVisible(company, startCompany);
  });
</script>
