---
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Section as SectionData } from '@/lib/sections';
import BrandMark from './BrandMark.astro';

interface Props {
  header: SectionData<'header'>;
  showcase: SectionData<'showcase'>;
}

const { header, showcase } = Astro.props;
const { team, brief, handoff, code, stack } = showcase.cells;

/** Orbit slots (top, right, bottom, left, then diagonals) for the integrations cell. */
const orbitSlots = [
  { left: '50%', top: '6%' },
  { left: '94%', top: '50%' },
  { left: '50%', top: '94%' },
  { left: '6%', top: '50%' },
  { left: '81%', top: '19%' },
  { left: '19%', top: '81%' },
];
const orbit = stack.tools
  .slice(0, orbitSlots.length)
  .map((tool, i) => ({ ...tool, ...orbitSlots[i] }));
const tilt = ['-rotate-3', 'rotate-2 translate-x-3', '-rotate-1 -translate-x-1'];
const cell = 'flex flex-col border-b border-r border-dashed border-border bg-card p-6 md:p-8';
const tile = 'grid place-items-center border border-border bg-card shadow-sm';
---

<Section
  id="showcase"
  eyebrow={header.eyebrow}
  title={header.title}
  description={header.description}
>
  <div class="border-t border-l border-dashed border-border">
    <div class="grid md:grid-cols-3" data-reveal-stagger="0.08" data-reveal-y="24">
      <!-- One team -->
      <div class={cell}>
        <h3 class="text-xl font-medium tracking-tight text-foreground">{team.title}</h3>
        <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">
          {team.description}
        </p>
        <div class="mt-6 flex-1">
          <div class="flex h-full flex-col items-center justify-center py-4">
            <div class="flex items-center gap-2.5 rounded-full border border-border bg-background py-2 pr-4 pl-2">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-foreground text-background">
                <Icon name="users" class="h-4 w-4" />
              </span>
              <span class="text-sm font-medium text-foreground">{team.hub}</span>
            </div>
            <div class="h-6 w-px bg-border"></div>
            <div class="w-full">
              <div class="mx-[12.5%] h-px bg-border"></div>
              <div class="grid grid-cols-4">
                {team.disciplines.map((discipline) => (
                  <div class="flex flex-col items-center">
                    <div class="h-6 w-px bg-border" />
                    <div class="grid h-11 w-11 place-items-center rounded-full border border-border bg-card text-foreground">
                      <Icon name={discipline.icon} class="h-4.5 w-4.5" />
                    </div>
                    <span class="mt-2 text-[10px] tracking-[0.08em] text-muted-foreground uppercase">
                      {discipline.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Starts with a conversation (chat) -->
      <div class={`${cell} md:row-span-2`}>
        <h3 class="text-xl font-medium tracking-tight text-foreground">{brief.title}</h3>
        <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">
          {brief.description}
        </p>
        <div class="mt-6 flex-1">
          <div class="flex h-full min-h-[420px] flex-col overflow-hidden rounded-2xl border border-border bg-background">
            <div class="flex items-center gap-2.5 border-b border-border px-4 py-3">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-foreground text-background">
                <BrandMark class="h-3.5 w-3.5" />
              </span>
              <div class="leading-tight">
                <p class="text-sm font-semibold text-foreground">{brief.studio}</p>
                <p class="mt-0.5 flex items-center gap-1.5 text-[10px] text-muted-foreground">
                  <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                  {brief.status}
                </p>
              </div>
            </div>
            <div class="flex flex-1 flex-col gap-3 p-4">
              <div class="max-w-[85%] self-end">
                <div class="rounded-2xl rounded-br-md bg-foreground px-3.5 py-2.5 text-xs leading-relaxed text-background">
                  {brief.request.text}
                </div>
                <p class="mt-1 text-right text-[10px] text-muted-foreground">
                  {brief.request.time}
                </p>
              </div>
              <div class="max-w-[85%] self-start">
                <div class="rounded-2xl rounded-bl-md border border-border bg-card px-3.5 py-2.5 text-xs leading-relaxed text-foreground">
                  {brief.reply}
                </div>
              </div>
              <div class="w-full max-w-[90%] self-start">
                <div class="overflow-hidden rounded-2xl rounded-bl-md border border-border bg-card">
                  <div class="border-b border-border px-3.5 py-2 text-[10px] font-medium tracking-[0.14em] text-muted-foreground uppercase">
                    {brief.plan.title}
                  </div>
                  <dl class="divide-y divide-border text-xs">
                    {brief.plan.rows.map((row) => (
                      <div class="flex items-center justify-between gap-3 px-3.5 py-2.5">
                        <dt class="text-muted-foreground">{row.label}</dt>
                        <dd
                          class:list={[
                            'text-right font-medium',
                            row.muted
                              ? 'flex items-center gap-1.5 text-muted-foreground'
                              : 'text-foreground',
                          ]}
                        >
                          {row.muted && <Icon name="minus-circle-filled" class="h-3 w-3" />}
                          {row.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  <div class="flex flex-wrap gap-1.5 border-t border-border px-3.5 py-2.5">
                    {brief.plan.tags.map((tag) => (
                      <span class="rounded-full border border-border bg-background px-2.5 py-1 text-[10px] font-medium text-muted-foreground">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <p class="mt-1 text-[10px] text-muted-foreground">{brief.plan.time}</p>
              </div>
            </div>
            <div class="flex items-center gap-3 border-t border-border px-4 py-3">
              <span class="flex-1 truncate text-xs text-muted-foreground">{brief.draft}</span>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-foreground text-background">
                <Icon name="send" class="h-3.5 w-3.5" />
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Handoff kit -->
      <div class={cell}>
        <h3 class="text-xl font-medium tracking-tight text-foreground">{handoff.title}</h3>
        <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">
          {handoff.description}
        </p>
        <div class="mt-6 flex-1">
          <div class="flex h-full items-center py-4">
            <div class="flex shrink-0 items-center gap-2 rounded-xl border border-border bg-background px-3 py-2 text-sm font-medium text-foreground">
              <Icon name="package" class="h-4 w-4" />
              {handoff.kit}
            </div>
            <div class="h-px min-w-6 flex-1 bg-border"></div>
            <div class="flex flex-col gap-4 border-l border-border py-2">
              {handoff.items.map((item) => (
                <div class="flex items-center">
                  <div class="h-px w-5 bg-border" />
                  <div class={`${tile} h-11 w-11 rounded-xl text-foreground`} title={item.label}>
                    <Icon name={item.icon} class="h-5 w-5" />
                    <span class="sr-only">{item.label}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- From chaos to a system in production -->
      <div class={cell}>
        <h3 class="text-xl font-medium tracking-tight text-foreground">{code.title}</h3>
        <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">
          {code.description}
        </p>
        <div class="mt-6 flex-1">
          <div class="relative grid h-full grid-cols-2 items-stretch gap-3 py-2">
            <div class="flex flex-col gap-2 rounded-xl border border-dashed border-border bg-background p-3">
              <span class="text-[10px] tracking-[0.14em] text-muted-foreground uppercase">
                {code.before.label}
              </span>
              <div class="flex flex-1 flex-col justify-center gap-2">
                {code.before.items.map((item, i) => (
                  <span
                    class={`flex w-fit max-w-full items-center gap-1.5 rounded-md border border-border bg-card px-2 py-1 text-[10px] text-muted-foreground shadow-sm ${tilt[i % tilt.length]}`}
                  >
                    <Icon name={item.icon} class="h-3 w-3 shrink-0" />
                    <span class="truncate">{item.label}</span>
                  </span>
                ))}
              </div>
            </div>
            <div class="flex flex-col gap-2 rounded-xl bg-foreground p-3 text-background">
              <span class="text-[10px] tracking-[0.14em] text-background/60 uppercase">
                {code.after.label}
              </span>
              <span class="text-xs font-medium">{code.after.title}</span>
              <div class="grid grid-cols-2 gap-1.5" aria-hidden="true">
                <div class="rounded-md bg-background/10 p-1.5">
                  <div class="h-1.5 w-6 rounded-full bg-background/40"></div>
                  <div class="mt-1.5 h-2 w-9 max-w-full rounded-full bg-emerald-300/70"></div>
                </div>
                <div class="rounded-md bg-background/10 p-1.5">
                  <div class="h-1.5 w-5 rounded-full bg-background/40"></div>
                  <div class="mt-1.5 h-2 w-7 max-w-full rounded-full bg-indigo-300/70"></div>
                </div>
              </div>
              <div class="mt-auto flex h-10 items-end gap-1" aria-hidden="true">
                {[40, 65, 50, 80, 70, 95].map((h) => (
                  <span class="flex-1 rounded-sm bg-background/30" style={{ height: `${h}%` }} />
                ))}
              </div>
            </div>
            <div
              class="pointer-events-none absolute inset-0 grid place-items-center"
              aria-hidden="true"
            >
              <span class="grid h-9 w-9 place-items-center rounded-full border border-border bg-card text-foreground shadow-sm">
                <Icon name="arrow-right" class="h-4 w-4" />
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Stack orbit -->
      <div class={cell}>
        <h3 class="text-xl font-medium tracking-tight text-foreground">{stack.title}</h3>
        <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">
          {stack.description}
        </p>
        <div class="mt-6 flex-1">
          <div class="relative mx-auto grid h-56 w-56 place-items-center py-2">
            <div class="orbit-spin absolute inset-0">
              <div class="absolute inset-4 rounded-full border border-dashed border-border"></div>
              {orbit.map((tool) => (
                <div
                  class="absolute -translate-x-1/2 -translate-y-1/2"
                  style={{ left: tool.left, top: tool.top }}
                >
                  <div
                    class={`orbit-counter ${tile} h-10 w-10 rounded-full text-foreground`}
                    title={tool.label}
                  >
                    <Icon name={tool.icon} class="h-4 w-4" />
                    <span class="sr-only">{tool.label}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="grid h-14 w-14 place-items-center rounded-full bg-foreground text-background shadow-md">
              <BrandMark class="h-6 w-6" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .orbit-spin {
      animation: orbit 40s linear infinite;
    }
    .orbit-counter {
      animation: orbit 40s linear infinite reverse;
    }
  }
  @keyframes orbit {
    to {
      rotate: 360deg;
    }
  }
</style>
