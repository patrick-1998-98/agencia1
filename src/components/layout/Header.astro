---
import { mainNav } from '@/data/site';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 w-full px-4 pt-4">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-5xl items-center justify-between rounded-full border border-border/60 bg-foreground/95 px-2 py-2 text-background shadow-[0_8px_30px_rgb(0,0,0,0.12)] backdrop-blur"
  >
    <a href="/" class="flex items-center gap-2 pr-2 pl-3 text-sm font-medium tracking-tight">
      <span class="text-base font-semibold">Zypher</span>
      <sup class="text-[10px] opacity-70">z</sup>
    </a>

    <ul class="hidden items-center gap-1 text-sm md:flex">
      {
        mainNav.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-1.5 transition-colors',
                isActive(link.href)
                  ? 'bg-background/15 text-background'
                  : 'text-background/70 hover:text-background',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 pr-1">
      <ThemeToggle class="hidden !border-transparent !bg-background !text-foreground sm:grid" />
      <a
        href="/contact"
        class="hidden rounded-full bg-background px-4 py-2 text-sm font-medium text-foreground transition-transform hover:-translate-y-0.5 hover:shadow-md sm:inline-flex"
      >
        Get In Touch
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-9 w-9 place-items-center rounded-full bg-background text-foreground md:hidden"
      >
        <svg
          class="menu-icon h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="8" x2="20" y2="8"></line>
          <line x1="4" y1="16" x2="20" y2="16"></line>
        </svg>
        <svg
          class="close-icon hidden h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    inert
    class="pointer-events-none fixed inset-x-4 top-20 z-40 origin-top scale-95 rounded-3xl border border-border/60 bg-foreground/95 p-6 text-background opacity-0 shadow-[0_20px_60px_rgb(0,0,0,0.25)] backdrop-blur transition-all duration-300 data-[open]:pointer-events-auto data-[open]:scale-100 data-[open]:opacity-100 md:hidden"
  >
    <ul class="flex flex-col gap-1 text-base">
      {
        mainNav.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block rounded-2xl px-4 py-3 transition-colors',
                isActive(link.href)
                  ? 'bg-background/15 text-background'
                  : 'text-background/75 hover:bg-background/10 hover:text-background',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="/contact"
      class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-background px-5 py-3 text-sm font-medium text-foreground"
    >
      Get In Touch
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.querySelector('.menu-icon')?.classList.toggle('hidden', open);
      toggle.querySelector('.close-icon')?.classList.toggle('hidden', !open);
      menu.toggleAttribute('data-open', open);
      menu.inert = !open;
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
