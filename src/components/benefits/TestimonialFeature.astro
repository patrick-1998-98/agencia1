---
import { Image } from 'astro:assets';
import type { Section as SectionData } from '@/lib/sections';

interface Props {
  quote: SectionData<'quote'>;
}

const { quote, name, role, company, avatar } = Astro.props.quote;
---

<section class="px-6 py-20">
  <figure
    class="mx-auto max-w-3xl rounded-3xl border border-border bg-card p-10 text-center md:p-14"
    data-reveal
  >
    <blockquote>
      <p class="text-2xl leading-snug font-medium tracking-tight text-balance md:text-3xl">
        “{quote}”
      </p>
    </blockquote>
    <figcaption class="mt-8 flex items-center justify-center gap-3">
      <Image
        src={avatar}
        alt=""
        width={40}
        height={40}
        densities={[1, 2]}
        class="h-10 w-10 rounded-full bg-muted object-contain"
      />
      <div class="text-left">
        <div class="text-sm font-medium">{name}</div>
        <div class="text-xs text-muted-foreground">
          {role} · {company}
        </div>
      </div>
    </figcaption>
  </figure>
</section>
