---
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Section as SectionData } from '@/lib/sections';

interface Props {
  roi: SectionData<'roi'>;
}

const { header, columns } = Astro.props.roi;
const format = new Intl.NumberFormat('en-US');
---

<Section id="roi" eyebrow={header.eyebrow} title={header.title} description={header.description}>
  <div class="border-y border-border">
    <div class="grid gap-6 md:grid-cols-2 md:gap-10" data-reveal-stagger="0.1" data-reveal-y="28">
      {columns.map((column) => (
        <div class="border-x border-border p-7 md:p-10">
          <div class="flex items-center gap-2.5">
            <Icon name={column.icon} class="h-4 w-4 text-foreground" />
            <h3 class="text-sm font-medium text-foreground">{column.title}</h3>
          </div>
          <p class="mt-8 text-xs tracking-eyebrow text-muted-foreground uppercase">
            Precious hours saved
          </p>
          <p class="mt-2 flex items-baseline gap-2">
            <span class="text-6xl leading-none font-medium tracking-tight text-foreground md:text-7xl">
              {format.format(column.hours)}+
            </span>
            <span class="text-lg text-muted-foreground">hours</span>
          </p>
          <ul class="mt-8 space-y-3">
            {column.points.map((point) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                <span
                  class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-foreground/50"
                  aria-hidden="true"
                />
                {point}
              </li>
            ))}
          </ul>
          <div class="mt-8 border-t border-dashed border-border pt-6">
            <p class="text-xs tracking-eyebrow text-muted-foreground uppercase">
              Return on investment
            </p>
            <p class="mt-3 text-5xl leading-none font-medium tracking-tight text-foreground md:text-6xl">
              {column.roi}x
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>
