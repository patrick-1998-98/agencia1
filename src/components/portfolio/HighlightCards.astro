---
/** "Every project ships with proof" — four outcome cards under the carousel. */
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import screenshot from '@/assets/images/portfolio/liquid-brokers-1.png';
import studio from '@/assets/images/hero-helmet-2.png';
import emoji5 from '@/assets/images/portfolio/avatars/emoji-5.png';
import emoji12 from '@/assets/images/portfolio/avatars/emoji-12.png';
import emoji23 from '@/assets/images/portfolio/avatars/emoji-23.png';
import emoji32 from '@/assets/images/portfolio/avatars/emoji-32.png';
import emoji41 from '@/assets/images/portfolio/avatars/emoji-41.png';
import emoji88 from '@/assets/images/portfolio/avatars/emoji-88.png';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  cards: { title: string; text: string }[];
}

const { eyebrow, title, description, cards } = Astro.props;
const [launch, scoped, senior, partner] = cards;
const team = [emoji5, emoji12, emoji23, emoji32, emoji88];
---

<Section id="highlights" eyebrow={eyebrow} title={title} description={description}>
  <div class="grid gap-5 md:grid-cols-12" data-reveal-stagger="0.1" data-reveal-y="26">
    {
      launch && (
        <div class="flex flex-col gap-6 overflow-hidden rounded-3xl bg-rose-100/60 p-7 md:col-span-6 md:flex-row md:items-center md:p-8 dark:bg-rose-950/20">
          <div class="md:w-1/2 md:self-end">
            <h3 class="max-w-[24ch] text-xl leading-snug font-semibold tracking-tight text-foreground md:text-2xl">
              {launch.title}
            </h3>
            <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">{launch.text}</p>
          </div>
          <div class="md:w-1/2">
            <div class="overflow-hidden rounded-xl border border-border bg-card shadow-[0_16px_40px_-16px_rgb(0,0,0,0.25)]">
              <div class="flex items-center gap-1.5 border-b border-border bg-muted/60 px-3 py-2" aria-hidden="true">
                <span class="h-2 w-2 rounded-full bg-muted-foreground/30" />
                <span class="h-2 w-2 rounded-full bg-muted-foreground/30" />
                <span class="h-2 w-2 rounded-full bg-muted-foreground/30" />
                <span class="ml-2 h-3 flex-1 rounded-full bg-background" />
              </div>
              <Image
                src={screenshot}
                alt="Liquid Brokers landing page, live in production"
                widths={[320, 640]}
                sizes="(min-width: 768px) 260px, calc(100vw - 6.5rem)"
                class="aspect-4/3 w-full object-cover object-top"
              />
            </div>
          </div>
        </div>
      )
    }
    {
      scoped && (
        <div class="flex flex-col justify-between gap-8 rounded-3xl bg-zinc-200/50 p-7 md:col-span-6 md:p-8 dark:bg-zinc-900/60">
          <div class="relative pt-3" aria-hidden="true">
            <div class="absolute inset-x-6 -top-0 h-14 rounded-xl bg-card/50" />
            <div class="absolute inset-x-3 top-1.5 h-14 rounded-xl bg-card/70" />
            <div class="relative flex items-center gap-3 rounded-xl bg-card px-4 py-3 shadow-sm">
              <Image src={emoji41} alt="" width={36} height={36} densities={[1, 2]} class="h-9 w-9 rounded-full bg-muted object-contain" />
              <div class="leading-tight">
                <p class="text-sm font-semibold text-foreground">Milestone approved</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Today, 11:56</p>
              </div>
              <span class="ml-auto text-sm font-semibold text-foreground">$45k</span>
            </div>
          </div>
          <div>
            <h3 class="max-w-[24ch] text-xl leading-snug font-semibold tracking-tight text-foreground md:text-2xl">
              {scoped.title}
            </h3>
            <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">{scoped.text}</p>
          </div>
        </div>
      )
    }
    {
      senior && (
        <div class="flex flex-col justify-between gap-8 rounded-3xl bg-emerald-100/50 p-7 md:col-span-5 md:p-8 dark:bg-emerald-950/20">
          <div class="flex -space-x-3" aria-hidden="true">
            {team.map((avatar) => (
              <Image src={avatar} alt="" width={48} height={48} densities={[1, 2]} class="h-12 w-12 rounded-full bg-card object-contain ring-4 ring-card" />
            ))}
            <span class="grid h-12 w-12 place-items-center rounded-full bg-foreground text-xs font-semibold text-background ring-4 ring-card">
              +3
            </span>
          </div>
          <div>
            <h3 class="max-w-[24ch] text-xl leading-snug font-semibold tracking-tight text-foreground md:text-2xl">
              {senior.title}
            </h3>
            <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">{senior.text}</p>
          </div>
        </div>
      )
    }
    {
      partner && (
        <div class="relative min-h-[240px] overflow-hidden rounded-3xl bg-amber-100/50 md:col-span-7 dark:bg-amber-950/20">
          <div class="relative z-10 flex h-full flex-col justify-center p-7 md:w-[55%] md:p-8">
            <h3 class="max-w-[24ch] text-xl leading-snug font-semibold tracking-tight text-foreground md:text-2xl">
              {partner.title}
            </h3>
            <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted-foreground">{partner.text}</p>
          </div>
          <Image
            src={studio}
            alt=""
            widths={[320, 640]}
            sizes="300px"
            class="absolute top-0 right-0 hidden h-full w-[42%] object-cover md:block"
          />
        </div>
      )
    }
  </div>
</Section>
