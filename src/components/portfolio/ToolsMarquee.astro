---
/** Infinite horizontal strip of tool logos (logos live in public/icon-tech). */
interface Props {
  label: string;
  items: { name: string; logo: string }[];
}

const { label, items } = Astro.props;
---

<section class="px-6 py-16">
  <div class="mx-auto max-w-6xl" data-reveal data-reveal-y="20">
    <p class="mb-8 text-center text-xs tracking-eyebrow text-muted-foreground uppercase">{label}</p>
    <div class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-linear-to-r from-background to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-linear-to-l from-background to-transparent"></div>
      <div class="flex animate-marquee items-center gap-14 whitespace-nowrap motion-reduce:animate-none">
        {
          [0, 1].map((copy) =>
            items.map((tool) => (
              <img
                src={`/icon-tech/${tool.logo}.svg`}
                alt={copy === 0 ? tool.name : ''}
                aria-hidden={copy === 1 ? 'true' : undefined}
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="h-9 w-auto opacity-60 transition-opacity hover:opacity-100 md:h-10 dark:invert"
              />
            )),
          )
        }
      </div>
    </div>
  </div>
</section>
