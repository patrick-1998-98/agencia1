---
/**
 * Fills its parent with a project still, or with a muted looping video
 * (remote, preloaded lazily) that uses the still as its poster.
 * Videos only play while on screen and never autoplay with reduced motion.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  media: { image: ImageMetadata; video?: string | undefined };
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  /** Show the round play/pause button (case-study pages). */
  toggle?: boolean;
  class?: string;
}

const {
  media,
  alt,
  widths,
  sizes,
  loading = 'lazy',
  toggle = false,
  class: className = 'block h-full w-full object-cover',
} = Astro.props;

const maxWidth = Math.max(...widths);
const poster = media.video
  ? await getImage({ src: media.image, width: Math.min(maxWidth, media.image.width), format: 'webp' })
  : undefined;
---

{
  media.video && poster ? (
    <div class="relative h-full w-full overflow-hidden" data-video-frame>
      <video
        src={media.video}
        poster={poster.src}
        muted
        loop
        playsinline
        preload="none"
        aria-label={alt || undefined}
        aria-hidden={alt ? undefined : 'true'}
        class={className}
        data-autoplay-video
      />
      {toggle && (
        <button
          type="button"
          aria-label="Play video"
          class="absolute right-3 bottom-3 grid h-9 w-9 place-items-center rounded-full bg-background/90 text-foreground shadow-md transition-transform hover:scale-110"
          data-video-toggle
        >
          <svg class="ml-0.5 h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-play>
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-pause>
            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
          </svg>
        </button>
      )}
    </div>
  ) : (
    <Image
      src={media.image}
      alt={alt}
      widths={widths.filter((w) => w <= media.image.width)}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      class={className}
    />
  )
}

<script>
  import { initAutoplayVideos } from './autoplay-video';
  initAutoplayVideos();
</script>
