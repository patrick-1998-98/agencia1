---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import ContactSection from '@/components/contact/ContactSection.astro';
import FaqList from '@/components/faq/FaqList.astro';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Missing src/content/pages/contact.yaml');
const { seo, hero, cta } = page.data;
---

<BaseLayout title={seo.title} description={seo.description}>
  <PageHero {...hero} />
  <ContactSection />
  <FaqList id="contact-quick-answers" openFirst />
  {cta && <CtaBanner {...cta} />}
</BaseLayout>
