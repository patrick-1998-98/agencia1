---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscás no existe." noindex>
  <section class="px-6 py-28 md:py-40">
    <div class="mx-auto flex max-w-3xl flex-col items-start gap-6">
      <p class="text-xs tracking-eyebrow text-muted-foreground uppercase">Error 404</p>
      <h1 class="text-4xl font-medium tracking-tight text-balance md:text-6xl">
        Esta página no existe
      </h1>
      <p class="max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg">
        Puede que el link esté roto o que la página se haya movido. Volvé al inicio o escribinos.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex items-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-transform hover:-translate-y-0.5"
        >
          Volver al inicio
        </a>
        <a
          href="/contact"
          class="inline-flex items-center rounded-full border border-border px-6 py-3 text-sm font-medium transition-colors hover:bg-muted"
        >
          Contacto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
