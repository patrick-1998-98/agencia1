---
import '@/styles/global.css';
import { createHash } from 'node:crypto';
import Seo, { type SeoProps } from '@/components/layout/Seo.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PageTransition from '@/components/layout/PageTransition.astro';
import AdminPromo from '@/components/layout/AdminPromo.astro';
import { site } from '@/data/site';
import { THEME_STORAGE_KEY } from '@/scripts/theme';

type Props = SeoProps;

const seo = Astro.props;

/*
 * Runs before first paint: flags JS support (enables reveal/curtain CSS) and
 * applies the stored theme so there is no light/dark flash. Its hash is added
 * to the Content-Security-Policy so it is the only inline script allowed.
 */
const bootScript = `(()=>{const d=document.documentElement;d.classList.add('js');try{d.classList.toggle('dark',localStorage.getItem(${JSON.stringify(THEME_STORAGE_KEY)})==='dark')}catch{}})();`;
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(bootScript).digest('base64')}`);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={bootScript} />
    <link
      rel="preload"
      href="/fonts/neue-haas-grotesk-display-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/neue-haas-grotesk-display-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[200] rounded-full bg-foreground px-4 py-2 text-sm text-background focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Saltar al contenido
    </a>
    <Header />
    <PageTransition />
    <div class="page-content">
      <main id="main" class="min-h-screen">
        <slot />
      </main>
    </div>
    <Footer />
    <AdminPromo />
    <script>
      import { initReveal } from '@/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
