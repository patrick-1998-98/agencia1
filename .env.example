# Copy to .env for local development. Never commit real values.
# On Render, set these under Service → Environment.

# Canonical origin for canonical URLs, Open Graph and the sitemap (build time).
SITE_URL=https://zypher-agency.online

# --- Contact form delivery (Resend, https://resend.com) -----------------------
# Required in production: without them POST /api/contact logs an error and
# answers 503. In `astro dev` leads are printed to the console instead.
RESEND_API_KEY=
# Inbox that receives leads (comma-separate several addresses).
CONTACT_TO_EMAIL=
# Verified Resend sender, e.g. "Zypher Website <leads@zypher-agency.online>".
CONTACT_FROM_EMAIL=

# --- Cloudflare Turnstile (optional bot protection) ---------------------------
# Set BOTH to enable. The widget loads lazily on first form interaction and the
# CSP is widened for challenges.cloudflare.com at build time only when the site
# key is present. Note: Turnstile requires JavaScript, so no-JS form posts are
# rejected while it is enabled.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
